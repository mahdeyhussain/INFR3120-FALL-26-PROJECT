<!DOCTYPE html>
<html>
<head>
  <title>Add Movie - CineScout</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body class="d-flex flex-column min-vh-100">

  <%- include('partials/header') %>

  <main class="container py-5 flex-grow-1">
    <h1>Add Movie</h1>
    <p>Enter the movie details below.</p>

    <form action="/movies/add" method="POST">

      <div class="mb-3">
        <label class="form-label">Movie Title</label>
        <input type="text" name="title" class="form-control" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Genre</label>
        <input type="text" name="genre" class="form-control" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Where to Watch</label>
        <input type="text" name="platform" class="form-control" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Release Year</label>
        <input type="number" name="year" class="form-control" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Rating (1-10)</label>
        <input type="number" name="rating" min="1" max="10" class="form-control" required>
      </div>

      <button type="submit" class="btn btn-primary">Add Movie</button>
      <a href="/" class="btn btn-secondary">Cancel</a>

    </form>
  </main>

  <%- include('partials/footer') %>

</body>
</html>
